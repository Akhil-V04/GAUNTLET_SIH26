# Copy to .env.local. Configure actual values locally and in Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix an OpenAI key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_REPORT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional override for cited historical extracts.
OPENAI_HISTORY_MODEL=gpt-4.1-mini
APP_URL=http://localhost:3000
